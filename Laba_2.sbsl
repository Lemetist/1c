метод НормализоватьФамилию(Фамилия: Строка): Строка
    пер Результат = ""
    пер Индекс = 0
    пер ФамилияВНижнемРегистре = Фамилия.ВНижнийРегистр()

    для Символ из ФамилияВНижнемРегистре
        если Индекс == 0
            Результат += Символ.ВВерхнийРегистр()
        иначе
            Результат += Символ
        ;

        Индекс += 1
    ;

    возврат Результат
;

метод ПервыеСимволы(Текст: Строка, Количество: Число): Строка
    пер Результат = ""
    пер Счетчик = 0

    для Символ из Текст
        если Счетчик < Количество
            Результат += Символ
            Счетчик += 1
        ;
    ;

    возврат Результат
;

метод УбратьЗнакиПрепинания(Текст: Строка): Строка
    пер Результат = ""

    для Символ из Текст
        если Символ != "." и Символ != "," и Символ != "?" и Символ != "!" и Символ != ":" и Символ != ";" и Символ != "-" и Символ != "«" и Символ != "»"
            Результат += Символ
        ;
    ;

    возврат Результат
;

метод РазбитьНаСтрокиПоДлине(Текст: Строка, ДлинаСтроки: Число): Массив<Строка>
    пер СтрокиТекста = новый Массив<Строка>()
    пер ТекущаяСтрока = ""
    пер Счетчик = 0

    для Символ из Текст
        ТекущаяСтрока += Символ
        Счетчик += 1

        если Счетчик == ДлинаСтроки
            СтрокиТекста.Добавить(ТекущаяСтрока)
            ТекущаяСтрока = ""
            Счетчик = 0
        ;
    ;

    если ТекущаяСтрока != ""
        СтрокиТекста.Добавить(ТекущаяСтрока)
    ;

    возврат СтрокиТекста
;

метод Задание1()
    Консоль.Записать("1. Проверка совершеннолетия")
    знч Возраст = Консоль.СчитатьЧисло("Введите возраст: ")

    если Возраст >= 18
        Консоль.Записать("Человек совершеннолетний")
    иначе
        Консоль.Записать("Человек несовершеннолетний")
    ;

    Консоль.Записать("")
;

метод Задание2()
    Консоль.Записать("2. Форматирование ФИО")
    пер ИсходноеФИО = "иВаноВ П.и."
    пер ЧастиФИО = ИсходноеФИО.Разделить(" ")
    пер Фамилия = НормализоватьФамилию(ЧастиФИО.Получить(0))
    пер Инициалы = ЧастиФИО.Получить(1).ВВерхнийРегистр()

    Консоль.Записать("Исходная строка: %{ИсходноеФИО}")
    Консоль.Записать("Результат: %{Фамилия} %{Инициалы}")
    Консоль.Записать("")
;

метод Задание3()
    Консоль.Записать("3. Вычисление sin(ln(x)) / x^2")
    пер Икс = 5
    пер Результат = Sin(Log(Икс)) / Степень(Икс, 2)

    Консоль.Записать("x = %{Икс}")
    Консоль.Записать("Результат: %{Результат}")
    Консоль.Записать("")
;

метод Задание4()
    Консоль.Записать("4. Удаление знаков препинания")
    пер Стих = "Точка ставится в конце.\нПравда же, подружки?\нЕсли точки на лице,\нИх зовут веснушки."
    пер СтихБезЗнаков = УбратьЗнакиПрепинания(Стих)

    Консоль.Записать(СтихБезЗнаков)
    Консоль.Записать("")
;

метод Задание5()
    Консоль.Записать("5. По 10 символов из каждой строки стихотворения")
    пер Стих = "Точка ставится в конце.\нПравда же, подружки?\нЕсли точки на лице,\нИх зовут веснушки."
    пер СтрокиСтиха = Стих.Разделить("\н")
    пер Результат = новый Массив<Строка>()

    для СтрокаСтиха из СтрокиСтиха
        Результат.Добавить(ПервыеСимволы(СтрокаСтиха, 10))
    ;

    Консоль.Записать(Строки.Соединить(Результат, Символы.НОВАЯ_СТРОКА))
    Консоль.Записать("")
;

метод Задание6()
    Консоль.Записать("6. Вычисление sin^2(a) + cos^2(a) - 2 * a^7")
    пер А = 2
    пер Результат = Степень(Sin(А), 2) + Степень(Cos(А), 2) - 2 * Степень(А, 7)

    Консоль.Записать("a = %{А}")
    Консоль.Записать("Результат: %{Результат}")
    Консоль.Записать("")
;

метод Задание7()
    Консоль.Записать("7. Целая и дробная части a / b")
    пер А = 17
    пер Б = 5
    пер Частное = А / Б
    пер ЦелаяЧасть = Частное.ЦелаяЧасть()
    пер ДробнаяЧасть = Частное - ЦелаяЧасть

    Консоль.Записать("a = %{А}, b = %{Б}")
    Консоль.Записать("Частное: %{Частное}")
    Консоль.Записать("Целая часть: %{ЦелаяЧасть}")
    Консоль.Записать("Дробная часть: %{ДробнаяЧасть}")
    Консоль.Записать("")
;

метод Задание8()
    Консоль.Записать("8. Начало и конец периодов для одной даты")
    пер ИсходнаяДата = новый ДатаВремя(2025, 10, 21, 14, 37, 52)

    Консоль.Записать("Исходная дата: %{ИсходнаяДата}")
    Консоль.Записать("Год: %{ИсходнаяДата.НачалоГода()} - %{ИсходнаяДата.КонецГода()}")
    Консоль.Записать("Квартал: %{ИсходнаяДата.НачалоКвартала()} - %{ИсходнаяДата.КонецКвартала()}")
    Консоль.Записать("Месяц: %{ИсходнаяДата.НачалоМесяца()} - %{ИсходнаяДата.КонецМесяца()}")
    Консоль.Записать("Неделя: %{ИсходнаяДата.НачалоНедели()} - %{ИсходнаяДата.КонецНедели()}")
    Консоль.Записать("День: %{ИсходнаяДата.НачалоДня()} - %{ИсходнаяДата.КонецДня()}")
    Консоль.Записать("Час: %{ИсходнаяДата.НачалоЧаса()} - %{ИсходнаяДата.КонецЧаса()}")
    Консоль.Записать("Минута: %{ИсходнаяДата.НачалоМинуты()} - %{ИсходнаяДата.КонецМинуты()}")
    Консоль.Записать("")
;

метод Задание9()
    Консоль.Записать("9. Порядковый день в году")
    пер МояДата = Дата{2025-10-21}

    Консоль.Записать("Дата: %{МояДата}")
    Консоль.Записать("Номер дня в году: %{МояДата.ДеньГода()}")
    Консоль.Записать("")
;

метод Задание10()
    Консоль.Записать("10. Сумма цифр и длина числа")
    пер ЧислоПользователя = Консоль.СчитатьЧисло("Введите целое положительное число: ")

    пока ЧислоПользователя <= 0
        ЧислоПользователя = Консоль.СчитатьЧисло("Число должно быть положительным. Повторите ввод: ")
    ;

    пер СтрокаЧисла = "" + ЧислоПользователя
    пер СуммаЦифр = 0

    для Символ из СтрокаЧисла
        СуммаЦифр += новый Число(Символ)
    ;

    Консоль.Записать("Сумма цифр: %{СуммаЦифр}")
    Консоль.Записать("Длина числа: %{СтрокаЧисла.Длина()}")
    Консоль.Записать("")
;

метод Задание11()
    Консоль.Записать("11. Разделение число-буквенной строки")
    пер ИсходнаяСтрока = "a1б2C3д4E5"
    пер ТолькоЦифры = ""
    пер ТолькоБуквы = ""

    для Символ из ИсходнаяСтрока
        если Символ.ТолькоЦифры()
            ТолькоЦифры += Символ
        иначе если Символ.ТолькоБуквы()
            ТолькоБуквы += Символ
        ;
    ;

    Консоль.Записать("Исходная строка: %{ИсходнаяСтрока}")
    Консоль.Записать("Только цифры: %{ТолькоЦифры}")
    Консоль.Записать("Только буквы: %{ТолькоБуквы}")
    Консоль.Записать("")
;

метод Задание12()
    Консоль.Записать("12. Текст по 15 символов и общая длина")
    пер Текст = "Звук распространяется в разных средах с неодинаковой скоростью. В воздухе при нормальных условиях это примерно 331 метр в секунду. Однако в твердых телах, например в стали, скорость звука может превышать 5000 метров в секунду."
    пер СтрокиТекста = РазбитьНаСтрокиПоДлине(Текст, 15)

    Консоль.Записать(Строки.Соединить(СтрокиТекста, Символы.НОВАЯ_СТРОКА))
    Консоль.Записать("Общая длина текста: %{Текст.Длина()}")
    Консоль.Записать("")
;

