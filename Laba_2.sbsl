метод ТипЧисловыеЗначения()
    знч Возраст = Консоль.СчитатьЧисло("Введите ваш возраст: ")
    если Возраст >= 18
        Консоль.Записать("Совершеннолетний")
    иначе
        Консоль.Записать("Несовершеннолетний")
    ;
;

метод Число()
    знч А = Консоль.СчитатьЧисло("Введите число: ")
    пер Выражение = Sin(Log(А)) / Степень(А, 2)
    Консоль.Записать(Выражение)
;

метод Скрипт()
    Число()
    ТипЧисловыеЗначения()
;