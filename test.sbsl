// Готовый скрипт на встроенном языке 1С:Предприятие 8.3
// Выполнить в консоли запросов или процедуре модуля

Процедура ВыполнитьЗадание()
    
    // === РАБОТА СО СТРОКАМИ ===
    
    // Строка с кавычками, однострочный формат
    СтрОднострочная = """" + "Текст в кавычках" + """";
    Сообщить("Однострочная: " + СтрОднострочная);
    
    // Многострочная строка
    СтрМногострочная = """Первая строка
    |Вторая строка""";
    Сообщить("Многострочная:");
    Сообщить(СтрМногострочная);
    
    // Строка используя только число 100
    Процент100 = 100;
    СтрЗаряд = """Заряжен на 100%
    |Заряжен на """ + Формат(Процент100 / 2, "ЧГ=0") + "%
    |Заряжен на """ + Формат(Процент100 / 4, "ЧГ=0") + "%""";
    Сообщить("Заряд:");
    Сообщить(СтрЗаряд);
    
    Сообщить(СтрРазделительСтрок());
    
    // === ЧИСЛОВЫЕ ЗНАЧЕНИЯ ===
    
    СуммаПокупки = 1200;
    Скидка = 7;
    ИтогСПСкидкой = СуммаПокупки * (100 - Скидка) / 100;
    Сообщить("Зинаида Петровна: 1200 руб. со скидкой 7% = " + ИтогСПСкидкой + " руб.");
    
    // Выражение с переменными (Перем1=10, Перем2=20, телефон ...5678)
    Перем1 = 10;
    Перем2 = 20;
    Последние4Цифры = 5678;
    РезультатЧисло = - (Перем1 + Перем2) / Перем2 * Перем1 % (Перем2 - Перем1) - Последние4Цифры;
    Сообщить("Числовое выражение: " + РезультатЧисло);
    
    Сообщить(СтрРазделительСтрок());
    
    // === ДАТА ===
    
    ДатаНач = Дата(2026,3,3);
    ДатаРезультат = ДобавитьКДате(ДатаНач, "Год", 7, "Месяц", 3, "День", 5);
    Сообщить("Дата +7л 3м 5д: " + ДатаРезультат);
    
    // === ВРЕМЯ ===
    
    ТекДатаВремя = ТекущаяДата();
    ТекВремя = ТекДатаВремя - НачалоДня(ТекДатаВремя);
    НовоеВремя = ТекВремя + 5000; // 5000 секунд
    Сообщить("Текущее время +5000с: " + НовоеВремя);
    
    // === ДАТАВРЕМЯ ===
    
    МаксДатаВремя = Дата(9999,12,31,23,59,59);
    ОстатокДатаВремя = МаксДатаВремя - ТекДатаВремя;
    Сообщить("До макс ДатаВремя: " + ОстатокДатаВремя);
    
    // === ДЛИТЕЛЬНОСТЬ ===
    
    // До конца пары (предполагаем 17:00 сегодня)
    КонецПары = НачалоДня(ТекДатаВремя) + 17 * 3600;
    Если ТекДатаВремя < КонецПары Тогда
        ОстатокПары = КонецПары - ТекДатаВремя;
        Сообщить("До конца пары (17:00): " + ОстатокПары);
    Иначе
        Сообщить("Пара закончилась");
    КонецЕсли;
    
    // До конца рабочего дня (18:00)
    КонецДняРаботы = НачалоДня(ТекДатаВремя) + 18 * 3600;
    Если ТекДатаВремя < КонецДняРаботы Тогда
        ОстатокДня = КонецДняРаботы - ТекДатаВремя;
        Сообщить("До конца рабочего дня (18:00): " + ОстатокДня);
    Иначе
        Сообщить("Рабочий день закончился");
    КонецЕсли;
    
    // === ЧАСОВОЙ ПОЯС ===
    // Чебоксары MSK+0 (UTC+3), текущее время то же
    Сообщить("Текущее время в Чебоксарах: " + Формат(ТекДатаВремя, "ДЛФ=DT"));
    
    Сообщить(СтрРазделительСтрок());
    
    // === БУЛЕВО ===
    
    Результат1 = (Истина ИЛИ Ложь) И (Истина И Ложь);
    Сообщить("1: (Истина ИЛИ Ложь) И (Истина И Ложь) = " + Результат1);
    
    Результат2 = НЕ (Истина И Ложь) ИЛИ (Истина И Истина И Ложь ИЛИ НЕ Истина);
    Сообщить("2: НЕ (Истина И Ложь) ИЛИ (Истина И Истина И Ложь ИЛИ НЕ Истина) = " + Результат2);
    
    Результат3 = (4375 / 16 * 0.9) > -(675 + 435 / 100 * (-73)) И НЕ Ложь;
    Сообщить("3: (4375 / 16 * 0.9) > - (675 + 435 / 100 * (-73)) И НЕ Ложь = " + Результат3);
    
КонецПроцедуры

ВыполнитьЗадание();

