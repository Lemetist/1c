структура Сотрудник
    обз пер ФИО: Строка
    обз пер ДатаРождения: Дата
    обз пер Должность: Строка
    обз пер Оклад: Число
;

структура Книга
    обз пер Название: Строка
    обз пер Автор: Строка
    обз пер ГодИздания: Число
;

метод Задание1()
    пер МассивЧисел = новый Массив<Число>()
    пер СуммаПоложительных = 0
    пер КоличествоПоложительных = 0
    пер Генератор = новый СлучайныйГенератор()

    для Индекс=1 по 15
        пер Число = Генератор.СлучайноеЦелое(0, 41) - 10
        МассивЧисел.Добавить(Число)

        если Число > 0
            СуммаПоложительных += Число
            КоличествоПоложительных += 1
        ;
    ;

    Консоль.Записать("1. Массив: %{МассивЧисел}")
    если КоличествоПоложительных > 0
        Консоль.Записать("Среднее арифметическое положительных элементов: %{СуммаПоложительных / КоличествоПоложительных}")
    иначе
        Консоль.Записать("В массиве нет положительных элементов")
    ;
;

метод Задание2()
    знч КоличествоСтудентов = Консоль.СчитатьЧисло("2. Введите количество студентов: ")
    пер Оценки = новый Массив<Число>()
    пер СуммаОценок = 0

    для Индекс=1 по КоличествоСтудентов
        пер Оценка = Консоль.СчитатьЧисло("Введите оценку студента %{Индекс} (от 2 до 5): ")
        пока Оценка < 2 или Оценка > 5
            Оценка = Консоль.СчитатьЧисло("Оценка должна быть в диапазоне от 2 до 5. Повторите ввод: ")
        ;

        Оценки.Добавить(Оценка)
        СуммаОценок += Оценка
    ;

    Консоль.Записать("Оценки группы: %{Оценки}")
    если КоличествоСтудентов > 0
        Консоль.Записать("Средняя оценка группы: %{СуммаОценок / КоличествоСтудентов}")
    иначе
        Консоль.Записать("Группа пустая")
    ;
;

метод Задание3()
    знч КоличествоЛюдей = Консоль.СчитатьЧисло("3. Введите количество людей: ")
    пер Возрасты = новый Массив<Число>()
    пер КоличествоМладше25 = 0
    пер Генератор = новый СлучайныйГенератор()

    для Индекс=1 по КоличествоЛюдей
        пер Возраст = Генератор.СлучайноеЦелое(16, 31)
        Возрасты.Добавить(Возраст)

        если Возраст < 25
            КоличествоМладше25 += 1
        ;
    ;

    Консоль.Записать("Возрасты: %{Возрасты}")
    Консоль.Записать("Количество людей младше 25 лет: %{КоличествоМладше25}")
;

метод Задание4()
    знч Н = Консоль.СчитатьЧисло("4. Введите n: ")
    пер Числа = новый Массив<Число>()
    пер СуммаКвадратов = 0
    пер СуммаКубов = 0

    для Индекс=0 по Н * 2 - 1
        пер Число = Консоль.СчитатьЧисло("Введите элемент с индексом %{Индекс}: ")
        Числа.Добавить(Число)

        если Индекс % 2 == 0
            СуммаКвадратов += Степень(Число, 2)
        иначе
            СуммаКубов += Степень(Число, 3)
        ;
    ;

    Консоль.Записать("4. Массив: %{Числа}")
    Консоль.Записать("Сумма квадратов элементов с четными индексами: %{СуммаКвадратов}")
    Консоль.Записать("Сумма кубов элементов с нечетными индексами: %{СуммаКубов}")
;

метод Задание5()
    пер ИсходныйМассив = новый Массив<Число>()
    пер НечетныеЧисла = новый Массив<Число>()
    пер Генератор = новый СлучайныйГенератор()

    для Индекс=1 по 10
        пер Число = Генератор.СлучайноеЦелое(1, 101)
        ИсходныйМассив.Добавить(Число)

        если Число % 2 != 0
            НечетныеЧисла.Добавить(Число)
        ;
    ;

    Консоль.Записать("5. Исходный массив: %{ИсходныйМассив}")
    Консоль.Записать("Массив без четных чисел: %{НечетныеЧисла}")

    если НечетныеЧисла.Размер() == 0
        Консоль.Записать("После удаления четных чисел массив пуст")
    иначе
        пер Минимум = НечетныеЧисла.Получить(0)
        пер Максимум = НечетныеЧисла.Получить(0)

        для Индекс=1 по НечетныеЧисла.Размер() - 1
            пер Число = НечетныеЧисла.Получить(Индекс)

            если Число < Минимум
                Минимум = Число
            ;

            если Число > Максимум
                Максимум = Число
            ;
        ;

        Консоль.Записать("Минимальное значение: %{Минимум}")
        Консоль.Записать("Максимальное значение: %{Максимум}")
    ;
;

метод Задание6()
    знч КоличествоТоваров = Консоль.СчитатьЧисло("6. Введите количество товаров: ")
    пер Цены = новый Массив<Число>()
    пер СуммаЦен = 0

    для Индекс=0 по КоличествоТоваров - 1
        пер Цена = Консоль.СчитатьЧисло("Введите цену товара с индексом %{Индекс}: ")
        Цены.Добавить(Цена)
        СуммаЦен += Цена
    ;

    если Цены.Размер() == 0
        Консоль.Записать("Массив цен пуст")
    иначе
        пер МинимальнаяЦена = Цены.Получить(0)
        пер МаксимальнаяЦена = Цены.Получить(0)
        пер ИндексМинимума = 0
        пер ИндексМаксимума = 0
        пер СредняяЦена = СуммаЦен / Цены.Размер()
        пер ДорогиеТовары = новый Массив<Число>()

        для Индекс=1 по Цены.Размер() - 1
            пер Цена = Цены.Получить(Индекс)

            если Цена < МинимальнаяЦена
                МинимальнаяЦена = Цена
                ИндексМинимума = Индекс
            ;

            если Цена > МаксимальнаяЦена
                МаксимальнаяЦена = Цена
                ИндексМаксимума = Индекс
            ;
        ;

        для Цена из Цены
            если Цена > СредняяЦена
                ДорогиеТовары.Добавить(Цена)
            ;
        ;

        Консоль.Записать("6. Массив цен: %{Цены}")
        Консоль.Записать("Минимальная цена: %{МинимальнаяЦена}, индекс: %{ИндексМинимума}")
        Консоль.Записать("Максимальная цена: %{МаксимальнаяЦена}, индекс: %{ИндексМаксимума}")
        Консоль.Записать("Средняя цена: %{СредняяЦена}")
        Консоль.Записать("Товары дороже среднего: %{ДорогиеТовары}")
    ;
;

метод Задание7()
    пер Сотрудники = новый Массив<Сотрудник>()

    Сотрудники.Добавить(новый Сотрудник("Иванов Иван Иванович", Дата{1998-03-12}, "Менеджер", 65000))
    Сотрудники.Добавить(новый Сотрудник("Петров Петр Сергеевич", Дата{1987-11-08}, "Бухгалтер", 72000))
    Сотрудники.Добавить(новый Сотрудник("Сидорова Анна Викторовна", Дата{1995-07-24}, "Аналитик", 81000))
    Сотрудники.Добавить(новый Сотрудник("Кузнецов Максим Олегович", Дата{1992-01-15}, "Разработчик", 95000))
    Сотрудники.Добавить(новый Сотрудник("Смирнова Елена Андреевна", Дата{2000-09-30}, "Тестировщик", 68000))

    Консоль.Записать("7. Сотрудники:")
    для СотрудникИзМассива из Сотрудники
        Консоль.Записать("ФИО: %{СотрудникИзМассива.ФИО}, дата рождения: %{СотрудникИзМассива.ДатаРождения}, должность: %{СотрудникИзМассива.Должность}, оклад: %{СотрудникИзМассива.Оклад}")
    ;
;

метод Задание8()
    пер Книги = новый Массив<Книга>()

    Книги.Добавить(новый Книга("Мастер и Маргарита", "Михаил Булгаков", 1967))
    Книги.Добавить(новый Книга("JavaScript: The Good Parts", "Douglas Crockford", 2008))
    Книги.Добавить(новый Книга("Чистый код", "Robert Martin", 2010))
    Книги.Добавить(новый Книга("Atomic Habits", "James Clear", 2018))
    Книги.Добавить(новый Книга("Краткие ответы на большие вопросы", "Stephen Hawking", 2018))

    Консоль.Записать("8. Книги, изданные после 2010 года:")
    для КнигаИзМассива из Книги
        если КнигаИзМассива.ГодИздания > 2010
            Консоль.Записать("Название: %{КнигаИзМассива.Название}, автор: %{КнигаИзМассива.Автор}, год издания: %{КнигаИзМассива.ГодИздания}")
        ;
    ;
;

метод Задание9()
    пер Продажи = новый Соответствие<Строка, Число>()
    Продажи.Вставить("Январь", 120000)
    Продажи.Вставить("Февраль", 98000)
    Продажи.Вставить("Март", 135000)
    Продажи.Вставить("Апрель", 142000)
    Продажи.Вставить("Май", 150000)
    Продажи.Вставить("Июнь", 130000)
    Продажи.Вставить("Июль", 160000)
    Продажи.Вставить("Август", 155000)
    Продажи.Вставить("Сентябрь", 125000)
    Продажи.Вставить("Октябрь", 170000)
    Продажи.Вставить("Ноябрь", 118000)
    Продажи.Вставить("Декабрь", 210000)

    пер ОбщаяСумма = 0
    пер ЛучшийМесяц = ""
    пер ХудшийМесяц = ""
    пер МаксимальныеПродажи = 0
    пер МинимальныеПродажи = 0
    пер ПервыйЭлемент = Истина

    для ЭлементПродаж из Продажи
        пер СуммаПродаж = ЭлементПродаж.Значение
        ОбщаяСумма += СуммаПродаж

        если ПервыйЭлемент
            ЛучшийМесяц = ЭлементПродаж.Ключ
            ХудшийМесяц = ЭлементПродаж.Ключ
            МаксимальныеПродажи = СуммаПродаж
            МинимальныеПродажи = СуммаПродаж
            ПервыйЭлемент = Ложь
        иначе
            если СуммаПродаж > МаксимальныеПродажи
                МаксимальныеПродажи = СуммаПродаж
                ЛучшийМесяц = ЭлементПродаж.Ключ
            ;

            если СуммаПродаж < МинимальныеПродажи
                МинимальныеПродажи = СуммаПродаж
                ХудшийМесяц = ЭлементПродаж.Ключ
            ;
        ;
    ;

    пер СредниеПродажи = ОбщаяСумма / Продажи.Размер()

    Консоль.Записать("9. Общая сумма продаж за год: %{ОбщаяСумма}")
    Консоль.Записать("Средние продажи за месяц: %{СредниеПродажи}")
    Консоль.Записать("Месяцы с продажами выше среднего:")
    для ЭлементПродаж из Продажи
        если ЭлементПродаж.Значение > СредниеПродажи
            Консоль.Записать("%{ЭлементПродаж.Ключ}: %{ЭлементПродаж.Значение}")
        ;
    ;
    Консоль.Записать("Лучший месяц: %{ЛучшийМесяц} (%{МаксимальныеПродажи})")
    Консоль.Записать("Худший месяц: %{ХудшийМесяц} (%{МинимальныеПродажи})")
;

метод Задание10()
    пер Товары = новый Соответствие<Строка, Число>()
    пер ОбновленныеТовары = новый Соответствие<Строка, Число>()
    Товары.Вставить("Хлеб", 50)
    Товары.Вставить("Молоко", 90)
    Товары.Вставить("Сыр", 350)
    Товары.Вставить("Чай", 180)
    Товары.Вставить("Кофе", 420)

    для Товар из Товары
        ОбновленныеТовары.Вставить(Товар.Ключ, Товар.Значение * 1.1)
    ;

    Консоль.Записать("10. Обновленные цены товаров:")
    для Товар из ОбновленныеТовары
        Консоль.Записать("%{Товар.Ключ}: %{Товар.Значение}")
    ;
;

метод Задание11()
    пер Пользователи = новый Соответствие<Строка, Строка>()
    Пользователи.Вставить("Менеджер", "manager123")
    Пользователи.Вставить("Бухгалтер", "buh2024")
    Пользователи.Вставить("Оператор", "oper_pass")

    если Пользователи.СодержитКлюч("Администратор")
        Пользователи.Вставить("Администратор", "new_admin_2026")
        Консоль.Записать("11. Пароль администратора обновлен")
    иначе
        Пользователи.Вставить("Администратор", "new_admin_2026")
        Консоль.Записать("11. Пользователь Администратор добавлен")
    ;

    Консоль.Записать("Текущее соответствие пользователь-пароль:")
    для Пользователь из Пользователи
        Консоль.Записать("%{Пользователь.Ключ}: %{Пользователь.Значение}")
    ;
;

