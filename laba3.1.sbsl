метод СоздатьИсходныйМассив(): Массив<Число>
    пер Генератор = новый СлучайныйГенератор()
    пер Массив = новый Массив<Число>()

    для Индекс=1 по 20
        Массив.Добавить(Генератор.СлучайноеЦелое(0, 101) - 50)
    ;

    возврат Массив
;

метод КопироватьМассив(ИсходныйМассив: Массив<Число>): Массив<Число>
    пер Копия = новый Массив<Число>()

    для Элемент из ИсходныйМассив
        Копия.Добавить(Элемент)
    ;

    возврат Копия
;

метод СортировкаВыбором(Массив: Массив<Число>)
    для Индекс=0 по Массив.Размер() - 2
        пер ИндексМинимума = Индекс

        для ВнутреннийИндекс=Индекс + 1 по Массив.Размер() - 1
            если Массив[ВнутреннийИндекс] < Массив[ИндексМинимума]
                ИндексМинимума = ВнутреннийИндекс
            ;
        ;

        если ИндексМинимума != Индекс
            пер Временное = Массив[Индекс]
            Массив[Индекс] = Массив[ИндексМинимума]
            Массив[ИндексМинимума] = Временное
        ;
    ;
;

метод СортировкаВставками(Массив: Массив<Число>)
    для Индекс=1 по Массив.Размер() - 1
        пер ТекущееЗначение = Массив[Индекс]
        пер Позиция = Индекс - 1

        пока Позиция >= 0 и Массив[Позиция] > ТекущееЗначение
            Массив[Позиция + 1] = Массив[Позиция]
            Позиция -= 1
        ;

        Массив[Позиция + 1] = ТекущееЗначение
    ;
;

метод СортировкаПузырьком(Массив: Массив<Число>)
    для Проход=0 по Массив.Размер() - 2
        для Индекс=0 по Массив.Размер() - 2 - Проход
            если Массив[Индекс] > Массив[Индекс + 1]
                пер Временное = Массив[Индекс]
                Массив[Индекс] = Массив[Индекс + 1]
                Массив[Индекс + 1] = Временное
            ;
        ;
    ;
;

метод ПоказатьРезультат(НазваниеАлгоритма: Строка, Объяснение: Строка, Массив: Массив<Число>)
    Консоль.Записать(НазваниеАлгоритма)
    Консоль.Записать("Результат сортировки: %{Массив}")
    Консоль.Записать("Принцип работы: %{Объяснение}")
    Консоль.Записать("")
;

метод Скрипт()
    пер ИсходныйМассив = СоздатьИсходныйМассив()
    пер МассивВыбором = КопироватьМассив(ИсходныйМассив)
    пер МассивВставками = КопироватьМассив(ИсходныйМассив)
    пер МассивПузырьком = КопироватьМассив(ИсходныйМассив)

    Консоль.Записать("Исходный массив из 20 элементов: %{ИсходныйМассив}")
    Консоль.Записать("Выбраны 3 алгоритма: сортировка выбором, сортировка вставками и сортировка пузырьком.")
    Консоль.Записать("")

    СортировкаВыбором(МассивВыбором)
    ПоказатьРезультат(
        "1. Сортировка выбором",
        "На каждом проходе алгоритм находит минимальный элемент в неотсортированной части массива и ставит его на очередную позицию слева.",
        МассивВыбором
    )

    СортировкаВставками(МассивВставками)
    ПоказатьРезультат(
        "2. Сортировка вставками",
        "Алгоритм последовательно берет элементы и вставляет каждый из них в правильное место внутри уже отсортированной левой части массива.",
        МассивВставками
    )

    СортировкаПузырьком(МассивПузырьком)
    ПоказатьРезультат(
        "3. Сортировка пузырьком",
        "Алгоритм многократно сравнивает соседние элементы и меняет их местами, из-за чего большие значения постепенно смещаются в конец массива.",
        МассивПузырьком
    )
;
